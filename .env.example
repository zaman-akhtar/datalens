# DataLens Environment Configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git. Only `.env.example` (this file) is committed.

# =============================================================================
# LLM Configuration
# =============================================================================

# Which LLM provider should the app use?
# Default per ADR-001: gemini.
# Valid values: gemini, anthropic, openai, groq
LLM_PROVIDER=gemini

# --- Primary key (matches LLM_PROVIDER above) ---

# Google Gemini — free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Backup keys (uncomment if you swap providers mid-project) ---

# Anthropic Claude — https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# OpenAI (paid) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Groq (free tier) — https://console.groq.com/keys
# GROQ_API_KEY=

# Optional: pin a particular model. Defaults below if omitted.
# gemini  -> gemini-1.5-flash
# openai  -> gpt-4o-mini
# anthropic -> claude-3-5-haiku-latest
# groq    -> llama-3.1-70b-versatile
# LLM_MODEL=

# Set MOCK_LLM=1 to use a deterministic fake provider (used in tests and demo
# rehearsal so we never hit rate limits during a recording).
MOCK_LLM=0

# =============================================================================
# Application Configuration
# =============================================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite path, relative to backend/
DATABASE_URL=sqlite:///./datalens.db

# Maximum CSV upload size in megabytes (returns HTTP 413 above this).
MAX_UPLOAD_SIZE_MB=50

# Hard cap on rows returned by query_data tool (LLM safety).
MAX_QUERY_ROWS=5000

# Maximum number of LLM tool calls per chat turn (prevents runaway loops).
MAX_TOOL_ITERATIONS=4

# =============================================================================
# Development Options
# =============================================================================

DEBUG=false

# CORS allowed origins for the dev frontend. Comma-separated for multiple.
CORS_ORIGINS=http://localhost:5173
